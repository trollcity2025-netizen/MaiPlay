{
  "compilerOptions": {
    "types": ["https://deno.land/x/supabase@1.51.0/mod.ts"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "NODE",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  }
}